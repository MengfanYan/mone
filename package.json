{
  "name": "financial-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/run.mjs start",
    "lint": "eslint .",
    "test": "python3 -m unittest discover -s tests -v",
    "eval": "python3 -m ml.evaluate",
    "check": "node scripts/check.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts tests/e2e *.mjs",
    "demo": "node scripts/demo.mjs dev",
    "demo:build": "node scripts/demo.mjs build",
    "demo:start": "node scripts/demo.mjs start",
    "cloud": "node scripts/cloud.mjs dev",
    "cloud:build": "node scripts/cloud.mjs build",
    "cloud:start": "node scripts/cloud.mjs start",
    "cloud:migrate": "node scripts/cloud.mjs migrate",
    "cloud:preflight": "node scripts/cloud.mjs preflight",
    "cloud:restore": "node scripts/cloud.mjs restore",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.mjs",
    "test:demo": "node --test tests/demo/*.test.mjs",
    "test:e2e:demo": "playwright test --config playwright.demo.config.mjs",
    "test:pdf": "node --test tests/pdf/*.test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.525.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.9",
    "react-day-picker": "^9.8.0",
    "react-dom": "19.1.9",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "node": "^22.23.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
