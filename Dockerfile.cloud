FROM node:22.23.3-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV WALLET_UI_MODE=cloud NEXT_TELEMETRY_DISABLED=1
RUN node scripts/cloud.mjs build

FROM node:22.23.3-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-cloud.lock ./
RUN python3 -m venv /opt/cloud-venv && /opt/cloud-venv/bin/pip install --no-cache-dir -r requirements-cloud.lock
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build --chown=node:node /app/.next-cloud ./.next-cloud
COPY --chown=node:node app ./app
COPY --chown=node:node components ./components
COPY --chown=node:node lib ./lib
COPY --chown=node:node locales ./locales
COPY --chown=node:node public ./public
COPY --chown=node:node services ./services
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node migrations ./migrations
COPY --chown=node:node next.config.mjs proxy.js jsconfig.json ./
ENV NODE_ENV=production WALLET_UI_MODE=cloud CLOUD_PYTHON=/opt/cloud-venv/bin/python CLOUD_BIND_HOST=0.0.0.0 PORT=10000 API_PORT=8766 NEXT_TELEMETRY_DISABLED=1
USER node
EXPOSE 10000
CMD ["node","scripts/cloud.mjs","start"]
