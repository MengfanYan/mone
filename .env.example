# Optional local settings. Copy to .env.local, or set these in your shell.
# Leave LOCAL_ACCESS_CODE unset to generate a new code at each launch.
# LOCAL_ACCESS_CODE=choose-at-least-12-characters
PORT=3000
API_PORT=8765
WALLET_MODE=local

# Optional cloud explanations. Server-only; every request requires a payload review.
# OPENAI_API_KEY=your_key_here
# WALLET_DB=/absolute/private/path/wallet.sqlite3
# PYTHON=python3
