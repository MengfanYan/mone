# Copy to .env.cloud.local. Never commit the filled file.
# Cloud preview uses managed Supabase Auth/PostgreSQL/Storage; no customer API key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-project-publishable-key
CLOUD_PUBLIC_ORIGIN=http://localhost:3002
# Separate non-owner login role granted wallet_api, with trusted CA verification.
# Do NOT use postgres, service_role or a BYPASSRLS/owner account here.
CLOUD_DATABASE_URL=host=db.your-project-ref.supabase.co port=5432 dbname=postgres user=wallet_runtime password=replace sslmode=verify-full sslrootcert=system
# Owner credential is read only by cloud:migrate and excluded from runtime children.
CLOUD_MIGRATION_DATABASE_URL=host=db.your-project-ref.supabase.co port=5432 dbname=postgres user=postgres password=replace sslmode=verify-full sslrootcert=system
# Generate 32+ random bytes for recovery-flow binding; store as a platform secret.
CLOUD_AUTH_FLOW_SECRET=replace-with-at-least-32-random-characters
CLOUD_PUBLIC_SIGNUP=false
BILLING_ENABLED=false
PORT=3002
API_PORT=8766
# Optional: CLOUD_PYTHON=/absolute/path/to/python-with-requirements-installed
# Independent deletion-control project. Never put its key in NEXT_PUBLIC_*.
# Create a private finagent-deletion-control bucket in this SECOND project.
# Upload key-manifest.json: {"required_key_ids":["v1"]}
CLOUD_JOURNAL_SUPABASE_URL=https://your-control-project-ref.supabase.co
CLOUD_JOURNAL_SERVICE_KEY=replace-with-control-project-service-role-key
CLOUD_DELETION_ACTIVE_KEY=v1
CLOUD_DELETION_KEYS_JSON={"v1":"replace-with-base64-of-32-random-bytes"}
# Operator-only restore configuration is never inherited by API/Next children.
# CLOUD_RESTORE_DATABASE_URL=... sslmode=verify-full sslrootcert=system
# CLOUD_RESTORE_ISOLATED=true
